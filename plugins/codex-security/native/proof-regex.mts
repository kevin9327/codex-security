  // Views with nonzero offsets exercise the Node-API typed-array boundary.
  const storage = Uint32Array.from([0, ...instructions, 0]);
  const code = storage.subarray(1, storage.length - 1);
  for (const [value, expected] of examples) {
    const units = new Uint16Array(value.length + 2).subarray(
      1,
      value.length + 1,
    );
    for (let index = 0; index < value.length; index++) {
      units[index] = value.charCodeAt(index);
    }
    assert.equal(native.regexFullMatch(code, units), expected, pattern);
    assertions++;
  }
  assert.deepEqual([...code], instructions);
