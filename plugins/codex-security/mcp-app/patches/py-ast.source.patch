+	return {
+		names: require("@unicode/unicode-15.0.0/Names/index.js"),
+		aliases: [
+			require("@unicode/unicode-15.0.0/Names/Abbreviation/index.js"),
+			require("@unicode/unicode-15.0.0/Names/Alternate/index.js"),
+			require("@unicode/unicode-15.0.0/Names/Control/index.js"),
+			require("@unicode/unicode-15.0.0/Names/Correction/index.js"),
+			require("@unicode/unicode-15.0.0/Names/Figment/index.js"),
+		],
