+/** Unicode 15.0 names and aliases, with CPython's algorithmic-name rules. */
+export function unicodeName(name: string): string | undefined {
+	if (/[^\x00-\x7f]/u.test(name)) return undefined;
+	const { names, aliases } = nameData ??= loadNameData();
+	let point: number | undefined;
+	if (name.startsWith("CJK UNIFIED IDEOGRAPH-")) {
+		const match = /^CJK UNIFIED IDEOGRAPH-([0-9A-F]{4,5})$/u.exec(name);
+		if (!match) return undefined;
+		point = parseInt(match[1], 16);
+		if (!names.get(point)?.startsWith("CJK Ideograph")) return undefined;
+	} else if (name.startsWith("HANGUL SYLLABLE ")) {
+		if (!hangulLookup) {
+			hangulLookup = new Map();
+			for (let index = 0; index < 11172; index++) {
+				const suffix = hangul.leading[Math.floor(index / 588)] +
+					hangul.vowel[Math.floor(index % 588 / 28)] + hangul.trailing[index % 28];
+				hangulLookup.set(`HANGUL SYLLABLE ${suffix}`, 0xac00 + index);
+			}
+		}
+		point = hangulLookup.get(name);
+	} else {
+		if (!nameLookup) {
+			nameLookup = new Map();
+			for (const [code, label] of names)
+				if (/^[A-Z]/u.test(label) && label === label.toUpperCase())
+					nameLookup.set(label, code);
+			for (const aliasSet of aliases)
+				for (const [code, labels] of Object.entries(aliasSet))
+					for (const label of labels) nameLookup.set(label, Number(code));
+		}
+		point = nameLookup.get(name.toUpperCase());
+	}
+	return point === undefined ? undefined : String.fromCodePoint(point);
+}
+
+export function isPrintable(character: string): boolean {
+	return character === " " || !(other.test(character) || separator.test(character));
+}
