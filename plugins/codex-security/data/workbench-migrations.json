      "        ALTER TABLE scan_progress",
      "        ADD COLUMN phase_items_total INTEGER NOT NULL DEFAULT 0",
      "            CHECK (phase_items_total >= 0);",
      "",
      "        ALTER TABLE scan_progress",
      "        ADD COLUMN phase_items_completed INTEGER NOT NULL DEFAULT 0",
