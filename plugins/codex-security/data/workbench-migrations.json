      "        ALTER TABLE scan_progress",
      "        ADD COLUMN phase_progress_unit TEXT CHECK (",
      "            phase_progress_unit IS NULL OR phase_progress_unit IN (",
      "                'checks',",
      "                'threat_surfaces',",
      "                'review_receipts',",
      "                'candidate_findings',",
      "                'validated_findings',",
      "                'report_artifacts'",
      "            )",
      "        );",
      "        "
    ]
  },
  {
    "version": 21,
